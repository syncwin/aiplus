{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/reminder.py\" 2>/dev/null || python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/contract_check.py\" 2>/dev/null || python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/contract_check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}