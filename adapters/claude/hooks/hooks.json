{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; command -v python3 >/dev/null 2>&1 || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/scripts/reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; command -v python3 >/dev/null 2>&1 || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; command -v python3 >/dev/null 2>&1 || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/scripts/screen_text.py\" --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; command -v python3 >/dev/null 2>&1 || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/scripts/contract_check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
