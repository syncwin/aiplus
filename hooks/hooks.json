{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/reminder.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/stop_check.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
